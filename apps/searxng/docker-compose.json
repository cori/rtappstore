{
  "services": [
    {
      "name": "searxng-valkey",
      "image": "valkey/valkey:8-alpine",
      "command": "valkey-server --save 30 1 --loglevel warning",
      "environment": [
        {
          "key": "TZ",
          "value": "${TZ}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/valkey",
          "containerPath": "/data"
        }
      ],
      "healthCheck": {
        "test": "valkey-cli ping",
        "interval": "10s",
        "timeout": "5s",
        "retries": 5
      }
    },
    {
      "name": "searxng",
      "image": "searxng/searxng:2026.7.31-057a77168",
      "isMain": true,
      "internalPort": 8080,
      "dependsOn": [
        "searxng-valkey"
      ],
      "environment": [
        {
          "key": "BASE_URL",
          "value": "${APP_PROTOCOL:-http}://${APP_DOMAIN}/"
        },
        {
          "key": "SEARXNG_SECRET",
          "value": "${SEARXNG_SECRET_KEY}"
        },
        {
          "key": "SEARXNG_REDIS_URL",
          "value": "redis://searxng-valkey:6379/0"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/etc/searxng"
        }
      ]
    }
  ],
  "schemaVersion": 2,
  "$schema": "https://schemas.runtipi.io/v2/dynamic-compose.json"
}