{
  "schemaVersion": 2,
  "services": [
    {
      "name": "photomap",
      "image": "ghcr.io/cori/photomap:1.0.0",
      "isMain": true,
      "environment": [
        { "key": "NODE_ENV", "value": "production" },
        { "key": "HOST", "value": "0.0.0.0" },
        { "key": "PORT", "value": "8787" },
        { "key": "CACHE_DIR", "value": "/data" },
        { "key": "TZ", "value": "${TZ}" }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ],
      "internalPort": "8787"
    }
  ]
}
