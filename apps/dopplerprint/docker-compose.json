{
  "schemaVersion": 2,
  "services": [
    {
      "name": "dopplerprint",
      "image": "forge.407.lol/cori/dopplerprint:sha-919a26d",
      "isMain": true,
      "internalPort": 8875,
      "command": "dopplerprint serve --host 0.0.0.0 --port 8875 --cache /data/cache --jobs /data/jobs",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ],
      "healthCheck": {
        "test": "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8875/', timeout=3)\"",
        "interval": "30s",
        "timeout": "5s",
        "retries": 3
      }
    }
  ]
}
